# Externally managed MySQL
# With host networking, use 127.0.0.1 when MySQL runs on this host.
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_USERNAME=agentscope
DB_PASSWORD=replace_me
DB_DATABASE=agentscope_studio
DB_POOL_SIZE=50
DB_SYNCHRONIZE=false

# Externally managed Redis. Leave blank for one Studio replica.
REDIS_URL=redis://redis.example.internal:6379

# Socket.IO
SOCKET_TRANSPORTS=websocket,polling
SOCKET_MAX_BUFFER_BYTES=26214400
CORS_ORIGIN=*
