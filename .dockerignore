# Build artifacts (will be created in container)
node_modules
dist

# Git
.git

# Docker (avoid recursive copy, except entrypoint)
docker
!docker/entrypoint.sh

# User data
data

# Local environment files may contain database credentials. Compose reads
# them on the host; they must never be sent into the image build context.
.env
.env.*
!.env.example
!.env.docker.example

# Database
*.sqlite
